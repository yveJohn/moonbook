# Moonbook local development only. Copy to .env and change values when needed.
COMPOSE_PROJECT_NAME=moonbook

POSTGRES_IMAGE=postgres:17.6-alpine
POSTGRES_HOST_PORT=15432
POSTGRES_DB=moonbook
POSTGRES_USER=moonbook
POSTGRES_PASSWORD=moonbook_local_postgres

REDIS_IMAGE=redis:7.4.5-alpine
REDIS_HOST_PORT=16379
REDIS_PASSWORD=moonbook_local_redis

MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
MINIO_ROOT_USER=moonbook
MINIO_ROOT_PASSWORD=moonbook_local_minio
MINIO_BUCKET=moonbook-content

MOONBOOK_SERVER_PORT=18888
MOONBOOK_JWT_SIGNING_KEY=change-me-local-jwt-signing-key
MOONBOOK_METRICS_TOKEN=change-me-local-metrics-token
MOONBOOK_ADMIN_HOST_PORT=18080
MOONBOOK_READER_HOST_PORT=18081
MOONBOOK_READER_ORIGIN=http://localhost:8081

# Optional EPUSDT callback verification; leave blank when the payment channel is disabled.
MOONBOOK_EPUSDT_PID=
MOONBOOK_EPUSDT_SECRET=
# Optional controlled gateway status sync endpoint; only use a trusted HTTPS endpoint in deployment.
MOONBOOK_EPUSDT_SYNC_URL=
