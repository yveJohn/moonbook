# Moonbook local development only. Copy to .env and change values when needed.
COMPOSE_PROJECT_NAME=moonbook

POSTGRES_IMAGE=postgres:17.6-alpine
POSTGRES_HOST_PORT=15432
POSTGRES_DB=moonbook
POSTGRES_USER=moonbook
POSTGRES_PASSWORD=moonbook_local_postgres

REDIS_IMAGE=redis:7.4.5-alpine
REDIS_HOST_PORT=16379
REDIS_PASSWORD=moonbook_local_redis

MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
MINIO_ROOT_USER=moonbook
MINIO_ROOT_PASSWORD=moonbook_local_minio
MINIO_BUCKET=moonbook-content

MOONBOOK_SERVER_PORT=18888
MOONBOOK_JWT_SIGNING_KEY=change-me-local-jwt-signing-key
MOONBOOK_METRICS_TOKEN=change-me-local-metrics-token
MOONBOOK_ADMIN_HOST_PORT=18080
MOONBOOK_READER_HOST_PORT=18081
MOONBOOK_ADMIN_ORIGIN=http://localhost:8080
MOONBOOK_READER_ORIGIN=http://localhost:8081
# Only the Compose gateway may supply X-Forwarded-* headers to the API.
MOONBOOK_TRUSTED_PROXIES=172.16.0.0/12
VITE_READER_API_BASE=/prod-api

# EPUSDT payment configuration. PID, Secret and endpoint values stay blank while disabled.
MOONBOOK_EPUSDT_PID=
MOONBOOK_EPUSDT_SECRET=
MOONBOOK_EPUSDT_CREDENTIAL_REF=primary
MOONBOOK_EPUSDT_VERIFY_CREDENTIALS_JSON=[]
MOONBOOK_EPUSDT_CREATE_URL=
MOONBOOK_EPUSDT_NOTIFY_URL=
MOONBOOK_EPUSDT_REDIRECT_URL=
MOONBOOK_EPUSDT_CONNECT_TIMEOUT_MS=3000
MOONBOOK_EPUSDT_REQUEST_TIMEOUT_MS=10000
MOONBOOK_EPUSDT_UNKNOWN_RELEASE_MINUTES=15
MOONBOOK_EPUSDT_CALLBACK_STALE_MINUTES=5
MOONBOOK_EPUSDT_HEALTH_URL=
MOONBOOK_EPUSDT_SYNC_URL=

MOONBOOK_AI_EXAMPLE_API_KEY=

# Forum cookies are injected at runtime. Sources only store a matching variable name.
MOONBOOK_FORUM_COOKIE_EXAMPLE=

# Optional local-only path used by moonbook-legacy-migrate novel-txt-imports.
MOONBOOK_LEGACY_TXT_MANIFEST=

# Optional monitoring profile. The token file content must exactly match
# MOONBOOK_METRICS_TOKEN and remain outside Git.
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1@sha256:27c475db5fb156cab31d5c18a4251ac7ed567746a2483ff264516437a39b15ba
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.17.1@sha256:38606faa38c54787525fb0ff2fd6b41b4cfb75d455c1df294927c5f611699b17
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.74.0@sha256:88862b6fc5004ead3495c16d5ba548b14e898fe6d22e7c5b93bf3df83823a9a5
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.27.0@sha256:a50c4c0eda297baa1678cd4dc4712a67fdea713b832d43ce7fcc5f9bea05094d
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1@sha256:f40e65878e25c2e78ea037f73a449527a0fb994e303dc3e34cb6b187b4b91435
MONITORING_WEBHOOK_IMAGE=moonbook/monitoring-webhook:local
POSTGRES_EXPORTER_PASSWORD=change-me-local-monitoring-password
MOONBOOK_METRICS_TOKEN_FILE=./.local/moonbook-metrics-token
PROMETHEUS_HOST_PORT=19090
ALERTMANAGER_HOST_PORT=19093
MONITORING_WEBHOOK_HOST_PORT=19094
PROMETHEUS_RETENTION_TIME=15d
MONITORING_WEBHOOK_FORWARD_URL=
MONITORING_WEBHOOK_FORWARD_TOKEN=
